#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NUM 1
#define NAV 2

// Keep the original 42 logical positions and both existing Space positions.
// Each line: left six keys, left thumb slot, right thumb slot, right six keys.
// Thumb slots are interleaved here; their physical order depends on the PCB.
// No hold-tap, toggle layers, Bluetooth clearing, or reset actions.

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T         &mo NUM      &kp ESC        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
                &kp LSHIFT   &kp A        &kp S        &kp D        &kp F        &kp G         &kp SPACE    &kp SPACE      &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp ENTER
                &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B         &mo NAV      &kp LGUI       &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp LALT
            >;
        };

        num_layer {
            bindings = <
                &trans       &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT     &trans       &trans         &kp ASTRK    &kp N7       &kp N8       &kp N9       &kp MINUS    &trans
                &trans       &kp SQT      &kp DQT      &kp LBRC     &kp RBRC     &kp EQUAL     &trans       &trans         &kp FSLH     &kp N4       &kp N5       &kp N6       &kp N0       &trans
                &trans       &kp LBKT     &kp RBKT     &kp BSLH     &kp GRAVE    &kp TILDE     &trans       &trans         &kp DOT      &kp N1       &kp N2       &kp N3       &kp PLUS     &trans
            >;
        };

        nav_layer {
            bindings = <
                &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5        &trans       &trans         &kp INSERT   &kp HOME     &kp UP       &kp END      &kp PG_UP    &kp DEL
                &trans       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10       &trans       &trans         &none        &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN    &trans
                &trans       &kp F11      &kp F12      &none        &none        &none         &trans       &trans         &none        &none        &none        &none        &none        &trans
            >;
        };
    };
};
